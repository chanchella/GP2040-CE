// OAG U10F-PM1-L1-BT-OUT1-P5
// HOGP-compatible BLE HID Gamepad peripheral profile.
// Keep the existing HID report service intact, but include the two services
// required for the HOGP HID Device role: Battery Service and
// Device Information Service.

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "OAG Universal Gamepad"
// Bluetooth Assigned Numbers: HID / Gamepad appearance = 0x03C4.
CHARACTERISTIC, GAP_APPEARANCE, READ, C4 03

// HOGP HID Device mandatory services.
#import <battery_service.gatt>
#import <device_information_service.gatt>

// HID Service
#import <hids.gatt>

// GATT Service / Database Hash
PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,
